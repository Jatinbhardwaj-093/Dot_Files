#!/bin/bash

# Export Homebrew binary path for launchd environment compatibility
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Source colors
source "$HOME/.config/sketchybar/colors.sh"

PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

# Unload previous items
sketchybar --remove '/.*/'

# Add custom events
sketchybar --add event aerospace_workspace_change

##### Bar Appearance (Gruvchad floating capsule) #####
sketchybar --bar \
  position=top \
  height=32 \
  color=0xe61d2021 \
  border_width=1 \
  border_color=0x22ebdbb2 \
  blur_radius=30 \
  corner_radius=12 \
  margin=10 \
  y_offset=10 \
  padding_left=8 \
  padding_right=8 \
  sticky=on \
  topmost=window

##### Defaults for All Items #####
default=(
  padding_left=4
  padding_right=4
  icon.font="JetBrainsMono Nerd Font:Bold:13.0"
  label.font="JetBrainsMono Nerd Font:Bold:11.5"
  icon.color=$FG1
  label.color=$FG1
  icon.padding_left=6
  icon.padding_right=6
  label.padding_left=0
  label.padding_right=6
  background.height=22
  background.corner_radius=6
  background.color=0xff282b2c
  background.border_width=1
  background.border_color=0x14ebdbb2
  background.padding_left=2
  background.padding_right=2
)
sketchybar --default "${default[@]}"

##### Left Items: Workspaces Only #####
source "$HOME/.config/sketchybar/items/spaces.sh"

##### Center Items: All Open Apps in Focused Workspace #####
sketchybar --add item space_windows center \
           --set space_windows \
                 icon.drawing=on \
                 icon.font="sketchybar-app-font:Regular:15.0" \
                 icon.color=$AQUA \
                 icon.padding_left=10 \
                 icon.padding_right=10 \
                 label.drawing=off \
                 background.color=0xff282b2c \
                 background.border_width=1 \
                 background.border_color=0x2282b3a8 \
                 background.corner_radius=6 \
                 background.height=22 \
                 padding_left=10 \
                 padding_right=10 \
                 script="$PLUGIN_DIR/space_windows.sh" \
           --subscribe space_windows front_app_switched aerospace_workspace_change window_change

##### Right Items: Arranged from Right to Left #####
# Note: SketchyBar places right items starting from the far right edge in the order they are added.

# 1. Consolidated Clock & Date Pill (Far Right)
sketchybar --add item clock right \
           --set clock \
                 update_freq=10 \
                 icon="󰃰" \
                 icon.color=$ORANGE \
                 label.color=$ORANGE \
                 background.border_color=0x22e78a4e \
                 script="$PLUGIN_DIR/clock.sh" \
           --subscribe clock mouse.entered mouse.exited

# 2. Battery Pill
sketchybar --add item battery right \
           --set battery \
                 update_freq=30 \
                 icon="󰁹" \
                 icon.color=$GREEN \
                 label.color=$GREEN \
                 background.border_color=0x22a9b665 \
                 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery power_source_change system_woke mouse.entered mouse.exited

# 3. RAM Pill
sketchybar --add item ram right \
           --set ram \
                 update_freq=5 \
                 icon="󰘚" \
                 icon.color=$BLUE \
                 label.color=$BLUE \
                 background.border_color=0x226d8dad \
                 script="$PLUGIN_DIR/ram.sh" \
           --subscribe ram mouse.entered mouse.exited

# 4. CPU Pill
sketchybar --add item cpu right \
           --set cpu \
                 update_freq=2 \
                 icon="󰍛" \
                 icon.color=$GREEN \
                 label.color=$GREEN \
                 background.border_color=0x22a9b665 \
                 script="$PLUGIN_DIR/cpu.sh" \
           --subscribe cpu mouse.entered mouse.exited

# 5. AeroSpace Workspace Layout Mode (Tiling - Leftmost on the Right side stack)
sketchybar --add item space_layout right \
           --set space_layout \
                 update_freq=0 \
                 icon.font="JetBrainsMono Nerd Font:Bold:13.0" \
                 icon.padding_right=4 \
                 label.drawing=on \
                 label.font="JetBrainsMono Nerd Font:Bold:11.5" \
                 label.padding_left=4 \
                 label.padding_right=8 \
                 script="$PLUGIN_DIR/space_layout.sh" \
                 click_script="/Users/jatinbhardwaj/.config/aerospace/toggle-space-layout.sh" \
           --subscribe space_layout aerospace_workspace_change front_app_switched mouse.entered mouse.exited

##### Force all scripts to run the first time #####
sketchybar --update
